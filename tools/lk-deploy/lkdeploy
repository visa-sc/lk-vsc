#!/usr/bin/env bash
# lkdeploy — выкладка визового клиентского ЛК (cabinet.html, index.html) для Екатерины Зайцевой.
#
#   lkdeploy pull              взять свежие боевые cabinet.html и index.html в ~/lk-deploy
#   lkdeploy status            что у вас отличается от боевого
#   lkdeploy check             проверить свои файлы, ничего не выкладывая
#   lkdeploy preview           показать свою версию по секретной ссылке (клиенты её не видят)
#   lkdeploy deploy            выложить на боевой (нужен ~/lk-deploy/CHANGELOG.md)
#   lkdeploy rollback ФАЙЛ     вернуть предыдущую версию (cabinet.html или index.html)
#   lkdeploy log               последние выкладки
#
# Сама команда ничего на боевом не меняет: она кладёт заявку ~/lk-deploy/REQUEST, а служба
# сервера (lk-deploy) проверяет файлы и выкладывает. Подробно — ~/lk-deploy/README.md.
set -u
W="$HOME/lk-deploy"; OUT=/var/lib/lk-deploy/out; CUR=/var/lib/lk-deploy/current
FILES="cabinet.html index.html"
[ "$(id -un)" = "kateadmin" ] || { echo "Запускать от пользователя kateadmin"; exit 1; }
mkdir -p "$W/.base" "$W/.changelog-archive"

cmd="${1:-help}"; arg="${2:-}"
case "$cmd" in
  pull|status|check|preview|deploy|log) ;;
  rollback) case "$arg" in cabinet.html|index.html) ;; *) echo "Укажите файл: lkdeploy rollback cabinet.html (или index.html)"; exit 1;; esac ;;
  *) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac

# Неразобранная свежая боевая версия (после pull при своих правках) — выкладывать рано:
# иначе ваш файл на старой основе затрёт чужие правки, пришедшие с pull.
if [ "$cmd" = "deploy" ]; then
  for f in $FILES; do
    if [ -f "$W/$f.prod" ]; then
      echo "Есть $f.prod — свежая боевая версия, в которую ещё не перенесены ваши правки."
      echo "Перенесите правки в неё, сохраните результат как $f, удалите $f.prod и выкладывайте."
      exit 1
    fi
  done
fi

id="$(date +%s)-$$-$RANDOM"
printf '{"id":"%s","cmd":"%s","file":"%s"}\n' "$id" "$cmd" "$arg" > "$W/REQUEST"

# Ждём ответ службы (обычно 1–3 секунды, выкладка с проверкой — до 30).
for _ in $(seq 1 90); do
  [ -f "$OUT/$id.txt" ] && break
  sleep 1
done
if [ ! -f "$OUT/$id.txt" ]; then
  echo "Служба выкладки не ответила за 90 секунд. Повторите команду; если снова тишина — напишите Андрею."
  exit 1
fi
cat "$OUT/$id.txt"
ok=0; head -1 "$OUT/$id.txt" | grep -q '^OK' && ok=1

if [ "$cmd" = "pull" ] && [ "$ok" = 1 ]; then
  for f in $FILES; do
    [ -f "$CUR/$f" ] || continue
    # Ваш файл без правок (совпадает с прошлым pull) — просто обновляем.
    # С правками — не трогаем, свежую боевую кладём рядом как ФАЙЛ.prod.
    if [ ! -f "$W/$f" ] || cmp -s "$W/$f" "$W/.base/$f"; then
      cp "$CUR/$f" "$W/$f"
      echo "  $f: обновлён до боевого"
    else
      cp "$CUR/$f" "$W/$f.prod"
      echo "  $f: у вас есть свои правки — боевая версия положена рядом как $f.prod, перенесите правки в неё"
    fi
    cp "$CUR/$f" "$W/.base/$f"
  done
fi

if [ "$cmd" = "deploy" ] && [ "$ok" = 1 ]; then
  for f in $FILES; do [ -f "$W/$f" ] && cp "$W/$f" "$W/.base/$f"; done
  mv "$W/CHANGELOG.md" "$W/.changelog-archive/$id.md" 2>/dev/null
fi
[ "$ok" = 1 ]
